{
  "name": "portfolio-compiler",
  "version": "1.0.0",
  "description": "Portfolio Compiler - AI-powered student portfolio generation and career-readiness platform",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "server": "node --watch --watch-exclude=\"server/data/**\" --watch-exclude=\"uploads/**\" server/index.js",
    "client": "vite --host 127.0.0.1 --port 5173",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "npm run build && npm run start"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.52.0",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.3"
  }
}
